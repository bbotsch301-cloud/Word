modules = ["nodejs-20", "web"]
run = "npm run build && npm run start"
hidden = [".config", ".git", "node_modules", ".next"]

[nix]
channel = "stable-24_05"

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5001
externalPort = 3000

[env]
PORT = "5000"

[deployment]
build = ["sh", "-c", "npm run build"]
run = ["sh", "-c", "npm run start"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pkill -f 'next-server' 2>/dev/null; pkill -f 'next start' 2>/dev/null; fuser -k 5000/tcp 2>/dev/null; sleep 2; rm -rf .next && npm run dev"
waitForPort = 5000
